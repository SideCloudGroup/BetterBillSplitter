# 项目名称
COMPOSE_PROJECT_NAME=expense
# 网站运行端口
WEB_PORT=17985

# gocraft HTTP 监听地址（容器中保持 :8000）
HTTP_SERVER__ADDR=:8000

# 数据库连接信息
MARIADB_HOST=mariadb
MARIADB_SOCKET=
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=123456
MARIADB_DATABASE=expense
MARIADB_USER=expense
MARIADB_PASSWORD=123456

# 推荐的新数据库配置；设置后优先于上面的兼容变量。
# DAO__DATABASE__DEFAULT__DSN=expense:123456@tcp(mariadb:3306)/expense?charset=utf8mb4&parseTime=True&loc=Local

# Redis（默认关闭；开启后以下连接信息生效）
APP__REDIS__ENABLED=false
DAO__REDIS__DEFAULT__ADDR=redis:6379
DAO__REDIS__DEFAULT__PASSWORD=
DAO__REDIS__DEFAULT__DB=0
APP__REDIS__KEY_PREFIX=better-bill-splitter:

# WebAuthn / Passkey（生产环境或反向代理后建议显式设置）
# APP__WEBAUTHN__RP_ID=bills.example.com
# APP__WEBAUTHN__RP_ORIGINS=https://bills.example.com
# APP__WEBAUTHN__DISPLAY_NAME=BetterBillSplitter

# 默认时区
APP_TIMEZONE=Asia/Shanghai

# JWT（登录 access / refresh；生产环境请更换 JWT_SECRET）
# 生成示例：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# access token 有效期（秒），默认 900 = 15 分钟
JWT_ACCESS_TTL=900
# refresh token 有效期（秒），默认 2592000 = 30 天
JWT_REFRESH_TTL=2592000
# 可选：JWT iss，非空时校验 token 的 iss 声明
JWT_ISS=
# refresh Cookie 是否仅 HTTPS；本地 HTTP 部署请设为 false
JWT_REFRESH_COOKIE_SECURE=false
